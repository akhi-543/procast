{
  "manifest_version": 3,
  "name": "procast",
  "version": "1.1",
  "description": "Lets procast search your open tabs, switch to a tab that already shows a page, and control YouTube Music.",
  "permissions": ["tabs", "nativeMessaging", "alarms", "cookies", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "key": ""
}
